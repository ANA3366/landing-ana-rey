{
  "meta": {
    "name": "Sistema Ana Rey",
    "description": "Marketing con sistema — base clara + acento naranja, plano y mobile-first",
    "flat": true,
    "mobileFirst": true
  },
  "color": {
    "bg": "#FAFAF7",
    "surface": "#F1EEE6",
    "ink": "#17150F",
    "inkSoft": "#46433A",
    "neutral": "#8A8578",
    "border": "#E4E0D6",
    "accent": "#FB6A2E",
    "accentDeep": "#E4531A",
    "accentTint": "#FFE7D8",
    "accentTintBorder": "#F6D3BF",
    "accentTintInk": "#96502E",
    "success": "#1F8A5B",
    "onDark": "#FAFAF7",
    "onDarkSoft": "#C7C3B8",
    "chipBg": "rgba(250,250,247,0.08)",
    "chipBorder": "rgba(250,250,247,0.12)"
  },
  "typography": {
    "fontFamily": {
      "display": "'Bricolage Grotesque', sans-serif",
      "body": "'Hanken Grotesque', sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 800
    },
    "tracking": {
      "tight": "-0.03em",
      "num": "-0.02em",
      "eyebrow": "0.14em"
    },
    "leading": {
      "tight": 1.04,
      "snug": 1.2,
      "body": 1.6
    },
    "scale": {
      "h1":        { "size": "clamp(34px, 7.2vw, 60px)", "family": "display", "weight": 800, "tracking": "-0.03em", "leading": 1.02, "use": "título hero" },
      "h2":        { "size": "clamp(28px, 6.2vw, 50px)", "family": "display", "weight": 800, "tracking": "-0.03em", "leading": 1.04, "use": "título de sección" },
      "subtitle":  { "size": "clamp(17px, 4vw, 22px)",   "family": "display", "weight": 600, "use": "subtítulo hero (acento)" },
      "lead":      { "size": "clamp(16px, 3.6vw, 19px)", "family": "body", "weight": 400, "leading": 1.6, "use": "cuerpo" },
      "cardTitle": { "size": "19px", "family": "display", "weight": 700, "use": "título de card (18–20)" },
      "cardBody":  { "size": "15px", "family": "body", "weight": 400, "leading": 1.55, "use": "cuerpo de card (14–15)" },
      "button":    { "size": "17px", "family": "display", "weight": 700, "use": "botones (15–17)" },
      "eyebrow":   { "size": "12px", "family": "body", "weight": 700, "tracking": "0.14em", "transform": "uppercase" },
      "stat":      { "size": "clamp(36px, 8vw, 58px)", "family": "display", "weight": 800, "tracking": "-0.02em", "use": "contadores / datos clave" }
    }
  },
  "spacing": {
    "section": "clamp(56px, 10vw, 100px)",
    "sectionLg": "clamp(60px, 11vw, 120px)",
    "gutter": "20px",
    "card": "26px",
    "cardLg": "clamp(26px, 5vw, 44px)",
    "gapGrid": "16px",
    "gapHero": "clamp(36px, 6vw, 56px)",
    "container": "1080px",
    "containerNarrow": "760px"
  },
  "radius": {
    "card": "18px",
    "cardLg": "22px",
    "block": "24px",
    "sm": "12px",
    "pill": "999px"
  },
  "shadow": {
    "none": "none",
    "cardHover": "0 8px 24px rgba(251,106,46,0.10)"
  },
  "motion": {
    "easeReveal": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "durReveal": "0.7s",
    "durUi": "0.2s",
    "revealShift": "16px",
    "liftCard": "-3px",
    "liftButton": "-2px",
    "orbitPeriod": "22s",
    "countDuration": "1.5s"
  },
  "fonts": {
    "googleFontsImport": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesque:wght@400;500;600;700&display=swap"
  }
}
